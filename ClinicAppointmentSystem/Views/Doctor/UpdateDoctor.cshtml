@model ClinicAppointmentSystem.Models.Doctor

@{
    ViewData["Title"] = "Update Doctor";
}

<h1>Update Doctor</h1>

<h4>Doctor</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="UpdateDoctor" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Hidden Input for Doctor Id -->
            <input type="hidden" asp-for="Id" />

            <!-- Doctor Name Input -->
            <div class="form-group">
                <label asp-for="Name" class="control-label">Doctor Name</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <!-- Doctor Specialty Input -->
            <div class="form-group">
                <label asp-for="Specialty" class="control-label">Specialty</label>
                <input asp-for="Specialty" class="form-control" />
                <span asp-validation-for="Specialty" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
