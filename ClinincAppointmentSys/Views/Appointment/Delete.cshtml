@model ClinincAppointmentSys.Models.Appointment

@{
	ViewData["Title"] = "Delete";
}

<div class="container d-flex justify-content-center align-items-center vh-100">
	<div class="card shadow-lg p-4" style="width: 500px; border-radius: 10px;">
		<h2 class="text-center mb-4 text-danger">Delete Appointment</h2>
		<hr />

		<p class="text-center text-muted">Are you sure you want to delete this appointment?</p>

		<div>
			<h4>Appointment</h4>
			<hr />
			<dl class="row">
				<dt class="col-sm-6 fw-bold text-secondary">
					@Html.DisplayNameFor(model => model.Patient)
				</dt>
				<dd class="col-sm-6">
					@Html.DisplayFor(model => model.Patient.Id)
				</dd>
				<dt class="col-sm-6 fw-bold text-secondary">
					@Html.DisplayNameFor(model => model.Doctor)
				</dt>
				<dd class="col-sm-6">
					@Html.DisplayFor(model => model.Doctor.Id)
				</dd>
				<dt class="col-sm-6 fw-bold text-secondary">
					@Html.DisplayNameFor(model => model.AppointmentDate)
				</dt>
				<dd class="col-sm-6">
					@Html.DisplayFor(model => model.AppointmentDate)
				</dd>
				<dt class="col-sm-6 fw-bold text-secondary">
					@Html.DisplayNameFor(model => model.Status)
				</dt>
				<dd class="col-sm-6" class="text-center mt-3">
					@Html.DisplayFor(model => model.Status)
				</dd>
			</dl>

			<form asp-action="Delete">
				<input type="hidden" asp-for="Id" />
				<button type="submit" class="btn btn-danger rounded-pill px-4">Delete</button>
				<a asp-action="Index" class="btn btn-secondary rounded-pill px-4">Cancel</a>
			</form>
		</div>

	</div>
</div>
