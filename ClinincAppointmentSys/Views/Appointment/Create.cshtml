@model ClinincAppointmentSys.Models.Appointment

@{
    ViewData["Title"] = "Create";
}

<div class="container mt-5 d-flex justify-content-center">
    <div class="card shadow-lg p-4 rounded-3 border-0" style="width: 500px;">
        <h2 class="text-center mb-4 text-primary fw-bolder">Create Appointment</h2>
        <hr class="mb-4">

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="mb-3">
                <label asp-for="PatientId" class="form-label fw-bold text-secondary"></label>
                <select asp-for="PatientId" class="form-control rounded-pill border-1" asp-items="ViewBag.Patients"></select>
            </div>
            <div class="form-group">
                <label asp-for="DoctorId" class="control-label fw-bold text-secondary"></label>
                <select asp-for="DoctorId" class="form-control rounded-pill border-1" asp-items="ViewBag.Doctors"></select>
            </div>
        

            <div class="mb-3">
                <label asp-for="AppointmentDate" class="form-label fw-bold text-secondary">Appointment Date</label>
                <input asp-for="AppointmentDate" class="form-control rounded-pill border-1" />
                <span asp-validation-for="AppointmentDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Status" class="form-label fw-bold text-secondary">Status</label>
                <input asp-for="Status" class="form-control rounded-pill border-1" />
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>


            <div class="text-center mt-4">
                <button type="submit" class="btn btn-warning rounded-pill px-4 fw-bold text-dark">Create</button>
                <a asp-action="Index" class="btn btn-outline-primary rounded-pill px-4 fw-bold">Back</a>
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
