@model ClinincAppointmentSys.Models.Appointment

@{
    ViewData["Title"] = "Edit Appointment";
}

<div class="container d-flex justify-content-center align-items-center vh-100">
    <div class="card shadow-lg p-4" style="width: 450px; border-radius: 10px;">
        <h2 class="text-center mb-4 text-primary">Edit Appointment</h2>
        <hr />

        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />

            <div class="mb-3 d-none">
                <label asp-for="PatientId" class="control-label fw-bold text-secondary"></label>
                <select asp-for="PatientId" class="form-control rounded-pill border-1" asp-items="ViewBag.Patients">
                    <option value="">-- Select Patient --</option>
                </select>
                <span asp-validation-for="PatientId" class="text-danger"></span>
            </div>

            <div class="mb-3 d-none">
                <label asp-for="DoctorId" class="control-label fw-bold text-secondary"></label>
                <select asp-for="DoctorId" class="form-control rounded-pill border-1" asp-items="ViewBag.Doctors">
                    <option value="">-- Select Doctor --</option>
                </select>
                <span asp-validation-for="DoctorId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="AppointmentDate" class="control-label fw-bold text-secondary"></label>
                <input asp-for="AppointmentDate" class="form-control rounded-pill border-1" />
                <span asp-validation-for="AppointmentDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Status" class="control-label fw-bold text-secondary"></label>
                <input asp-for="Status" class="form-control rounded-pill border-1" />
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-between">
                <button type="submit" class="btn btn-warning rounded-pill px-4">Save</button>
                <a asp-action="Index" class="btn btn-secondary rounded-pill px-4">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
